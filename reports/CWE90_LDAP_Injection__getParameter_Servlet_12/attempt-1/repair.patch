+    private String escapeLdapSearchFilter(String filter)
+    {
+        StringBuilder escaped = new StringBuilder();
+        for (int i = 0; i < filter.length(); i++)
+        {
+            char current = filter.charAt(i);
+            switch (current)
+            {
+                case '\\':
+                    escaped.append("\\5c");
+                    break;
+                case '*':
+                    escaped.append("\\2a");
+                    break;
+                case '(':
+                    escaped.append("\\28");
+                    break;
+                case ')':
+                    escaped.append("\\29");
+                    break;
+                case '\u0000':
+                    escaped.append("\\00");
+                    break;
+                default:
+                    escaped.append(current);
+            }
+        }
+        return escaped.toString();
+    }
